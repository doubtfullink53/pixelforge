# Copy this file to .env (next to server.py) and fill in one key.
# .env is git-ignored: the key never reaches the browser.

AI_PROVIDER=wavespeed

# WaveSpeedAI — one key, 1,000+ image models: https://wavespeed.ai/access-key
AI_IMAGE_KEY=your_key_here

# Any model id the provider offers. This one is fast and cheap.
AI_IMAGE_MODEL=wavespeed-ai/z-image/turbo

# ---------------------------------------------------------------------------
# Or any OpenAI-compatible image endpoint you have access to. The base URL is
# required here — not every OpenAI-compatible API exposes /images/generations,
# so point it at whatever your account's image endpoint is.
# ---------------------------------------------------------------------------
# AI_PROVIDER=openai
# AI_IMAGE_BASE_URL=https://your-provider.example.com/v1
# AI_IMAGE_MODEL=gpt-image-1
# AI_IMAGE_KEY=your_key_here
